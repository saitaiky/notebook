{
  "name": "docs",
  "description": "Hasura GraphQL Engine Documentation",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 8888",
    "fresh-start": "yarn clear && yarn start",
    "build": "docusaurus build",
    "build:base-url": "yarn run build --out-dir build/docs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test:graph": "node --test src/plugins/knowledge-graph/buildGraph.test.js",
    "spellcheck": "./spell_check.sh",
    "spelladd": "./spell_add.sh",
    "format": "prettier --write \"**/*.+(js|jsx|css|json|md|mdx)\""
  },
  "dependencies": {
    "@docusaurus/core": "^3.0.0",
    "@docusaurus/plugin-google-gtag": "^3.4.0",
    "@docusaurus/preset-classic": "^3.0.0",
    "@docusaurus/theme-mermaid": "^3.4.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@mdx-js/react": "^3.0.0",
    "algoliasearch": "^4.14.2",
    "algoliasearch-helper": "^3.7.4",
    "clsx": "^1.2.1",
    "commentbox.io": "^2.1.0",
    "cspell": "^6.18.1",
    "docusaurus-plugin-sass": "^0.2.2",
    "fast-glob": "3.3.2",
    "graphiql": "^1.5.1",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphql": "^15.7.2",
    "graphql-ws": "^5.11.2",
    "gray-matter": "4.0.3",
    "plugin-image-zoom": "flexanalytics/plugin-image-zoom",
    "prism-react-renderer": "^2.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "react-transition-group": "^4.4.2",
    "rehype-katex": "7",
    "remark-math": "6",
    "remark-mdx": "^2.3.0",
    "remark-parse": "^11.0.0",
    "sass": "^1.49.8",
    "seedrandom": "3.0.5",
    "styled-components": "^6.1.0",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0",
    "unified": "^10.1.2",
    "unist-util-visit": "^5.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@docusaurus/tsconfig": "3.0.0",
    "@swc/core": "^1.3.23",
    "@types/react": "^18.2.29",
    "prettier": "^3.0.0",
    "swc-loader": "^0.2.3",
    "typescript": "~5.2.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@3.2.4"
}
